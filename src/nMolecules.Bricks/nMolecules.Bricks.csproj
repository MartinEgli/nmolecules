<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>NMolecules.Bricks</RootNamespace>
    <Version>0.2.2</Version>
    <PackageId>NMolecules.Bricks</PackageId>
    <PackageDescription>Composable architectural bricks for custom attributes and runtime-configurable generic rules in nMolecules.</PackageDescription>
    <PackageIcon>caffeine-molecule.png</PackageIcon>
    <Title>nMolecules Bricks</Title>
    <Authors>Oliver Drotbohm, Stephan Pirnbaum, Henning Schwentner</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/xmolecules/nmolecules</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\images\caffeine-molecule.png" Pack="true" PackagePath="" />
    <Folder Include="Attributes\" />
  </ItemGroup>
</Project>

